[Unit]
Description=Pocket Slides — tabletop role-playing games (5E)
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-slides
Group=pocket-slides
ExecStart=/usr/local/bin/pocket-slides
Environment=DATA_DIR=/var/lib/pocket-slides
Environment=PORT=8080
Environment=BASE_URL=https://forum.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-slides
PrivateTmp=true

[Install]
WantedBy=multi-user.target
